{
  "app-id": "com.linuxkamarada.Hearts",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "hearts",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-run/dconf",
    "--filesystem=~/.config/dconf:ro",
    "--talk-name=ca.desrt.dconf",
    "--env=DCONF_USER_CONFIG_DIR=.config/dconf"
  ],
  "modules": [
    {
      "name": "hearts",
      "buildsystem": "meson",
      "subdir": "hearts",
      "post-install": [
        "for size in 16x16 22x22 24x24 32x32 40x40 48x48 256x256; do install -Dm644 /app/share/icons/hicolor/${size}/apps/gnome-hearts.png /app/share/icons/hicolor/${size}/apps/com.linuxkamarada.Hearts.png; done",
        "sed -i 's/^Icon=gnome-hearts$/Icon=com.linuxkamarada.Hearts/' /app/share/applications/com.linuxkamarada.Hearts.desktop"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/kamarada/gnome-hearts.git",
          "tag": "v0.4.0-beta"
        }
      ]
    }
  ]
}
