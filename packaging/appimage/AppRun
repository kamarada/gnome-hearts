#!/usr/bin/env bash
# Custom AppRun for the Hearts AppImage (see build-appimage.sh and
# ../README.md). Copied into AppDir/AppRun as the final build step,
# overwriting the one linuxdeploy generates by default -- that default one
# just execs AppDir/usr/bin/hearts directly, which doesn't work here for
# two reasons this script exists to fix:
#
# 1. usr/bin/hearts is a Python script, not an ELF binary, so linuxdeploy
#    never patched it with an rpath pointing back into the bundle; without
#    LD_LIBRARY_PATH/GI_TYPELIB_PATH pointing at AppDir/usr/lib, `import gi`
#    would either fail outright or silently pick up the *host's* GTK4
#    stack instead of the one actually bundled here.
# 2. hearts-launcher's sys.path.insert() (see hearts/hearts.in) bakes in
#    an absolute build-time path (e.g. /usr/lib/python3.14/site-packages)
#    that has nothing to do with wherever this AppImage ends up mounted at
#    run time -- so this script bypasses that launcher entirely and calls
#    `python3 -m hearts.main` itself, with PYTHONPATH pointing at the
#    bundled hearts/ package directly.
set -e
HERE="$(dirname "$(readlink -f "${0}")")"

# GTK4/libadwaita runtime environment (icon/schema/typelib paths, pixbuf
# loader cache, dark/light theme detection, ...), generated by linuxdeploy's
# gtk plugin at build time -- see build-appimage.sh.
for hook in "$HERE"/apprun-hooks/*.sh; do
  [ -f "$hook" ] && source "$hook"
done

# The hook above covers GTK's own module/data lookup, but not plain shared
# library resolution for whatever calls dlopen() on e.g. libgtk-4.so.1 by
# soname (gi's typelib loader) -- without this, that resolves against the
# host's copy of these libraries (if present at all) rather than the
# bundled one, silently defeating the bundling above.
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Overrides card_renderer.find_cards_svg()'s installed-prefix lookup, which
# otherwise resolves against the absolute path Meson baked in at build
# time (e.g. /usr/share/hearts) -- meaningless once this bundle is mounted
# somewhere else entirely (e.g. /tmp/.mount_XXXXXX).
export HEARTS_PKGDATADIR="$HERE/usr/share/hearts"

# Hearts is pure Python (no compiled extensions of its own), so unlike the
# GTK4/libadwaita/librsvg stack above, its own package doesn't need to be
# bundled per-Python-version -- deliberately not hardcoding "python3.X"
# here so this keeps working regardless of which Python built this bundle.
PYTHON_SITE_DIR="$(find "$HERE/usr/lib" -maxdepth 2 -type d -name site-packages | head -n1)"
export PYTHONPATH="$PYTHON_SITE_DIR${PYTHONPATH:+:$PYTHONPATH}"

# Deliberately NOT bundling Python itself or PyGObject (the `gi` module) --
# see ../README.md's Scope section for why. This is the one real runtime
# dependency this AppImage doesn't carry itself.
exec python3 -m hearts.main "$@"
